{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS5 Dongle Manager",
  "version": "2.0.0",
  "identifier": "io.github.doorwarning.ds5donglemanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS5 Dongle Manager",
        "width": 1400,
        "height": 800,
        "minWidth": 1400,
        "minHeight": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "shortDescription": "Desktop manager for the DS5Dongle Switch fork.",
    "longDescription": "Configure the Pico 2 W DualSense dongle: PC mode settings, Switch Pro (NS) mode features and switching between the two.",
    "icon": [
      "icons/pwa-icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/sounds/controller-connected.wav",
      "resources/sounds/controller-disconnected.wav",
      "resources/sounds/controller-low-battery.wav"
    ]
  }
}
